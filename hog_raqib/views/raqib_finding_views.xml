<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_raqib_finding_list" model="ir.ui.view">
        <field name="name">raqib.finding.list</field>
        <field name="model">raqib.finding</field>
        <field name="arch" type="xml">
            <list decoration-danger="classification == 'nc_major'"
                  decoration-warning="classification == 'nc_minor'"
                  default_group_by="audit_id">
                <field name="number" width="60px"/>
                <field name="audit_id"/>
                <field name="clause_id"/>
                <field name="standard_ids" widget="many2many_tags"
                       string="المواصفات" optional="show"/>
                <field name="description"/>
                <field name="classification" widget="badge"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_raqib_finding_form" model="ir.ui.view">
        <field name="name">raqib.finding.form</field>
        <field name="model">raqib.finding</field>
        <field name="arch" type="xml">
            <form string="ملاحظة">
                <sheet>
                    <group>
                        <group>
                            <field name="audit_id"/>
                            <field name="number" readonly="1"/>
                            <field name="clause_id"/>
                            <field name="clause_ids" widget="many2many_tags"
                                   string="البنود المشمولة (عند الدمج)"/>
                        </group>
                        <group>
                            <field name="standard_ids" widget="many2many_tags"
                                   string="المواصفات" readonly="1"/>
                            <field name="classification"/>
                            <field name="state"/>
                        </group>
                    </group>
                    <field name="description"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_raqib_finding" model="ir.actions.act_window">
        <field name="name">الملاحظات</field>
        <field name="res_model">raqib.finding</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
