<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_raqib_clause_list" model="ir.ui.view">
        <field name="name">raqib.clause.list</field>
        <field name="model">raqib.clause</field>
        <field name="arch" type="xml">
            <list default_group_by="standard_id">
                <field name="number" width="80px"/>
                <field name="name"/>
                <field name="is_leaf" optional="hide"/>
                <field name="applies_stage1" widget="boolean_toggle"/>
                <field name="applies_stage2" widget="boolean_toggle"/>
                <field name="applies_surveillance" widget="boolean_toggle"/>
                <field name="applies_recert" widget="boolean_toggle"/>
                <field name="is_surveillance_core" widget="boolean_toggle"
                       optional="show"/>
                <field name="stage1_focus" optional="hide"/>
                <field name="standard_id" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_raqib_clause_form" model="ir.ui.view">
        <field name="name">raqib.clause.form</field>
        <field name="model">raqib.clause</field>
        <field name="arch" type="xml">
            <form string="بند مواصفة">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="number" class="oe_inline"/> — <field name="name" class="oe_inline"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="standard_id"/>
                            <field name="parent_id"/>
                            <field name="sequence"/>
                        </group>
                        <group string="نطاق الزيارة">
                            <field name="is_leaf"/>
                            <field name="applies_stage1"/>
                            <field name="applies_stage2"/>
                            <field name="applies_surveillance"/>
                            <field name="applies_recert"/>
                            <field name="is_surveillance_core"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="المتطلب">
                            <field name="requirement"/>
                        </page>
                        <page string="المرحلة الأولى"
                              invisible="not applies_stage1">
                            <div class="alert alert-info" role="alert">
                                المرحلة الأولى مراجعة وثائقية وجاهزية وفهم ونطاق
                                (ISO/IEC 17021-1 §9.3.1.2.2). ما يُكتب هنا يظهر
                                للمدقق داخل التطبيق في تدقيقات المرحلة الأولى فقط.
                            </div>
                            <field name="stage1_focus"
                                   placeholder="ما الذي يُفحص تحديداً في المرحلة الأولى لهذا البند؟"/>
                        </page>
                        <page string="الدليل المتوقع">
                            <group>
                                <field name="auditor_input_hint"/>
                            </group>
                            <field name="evidence_expected" placeholder="ما الذي يبحث عنه المدقق..."/>
                        </page>
                        <page string="الأمثلة الإرشادية">
                            <field name="evidence_hint" placeholder="أمثلة نقاط قوة/ضعف، سجلات نموذجية..."/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_raqib_clause" model="ir.actions.act_window">
        <field name="name">بنود المواصفات</field>
        <field name="res_model">raqib.clause</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_raqib_standard" model="ir.actions.act_window">
        <field name="name">المواصفات</field>
        <field name="res_model">raqib.standard</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
