<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="privilege_raqib" model="res.groups.privilege">
        <field name="name">رقيب — التدقيق</field>
        <field name="sequence">60</field>
    </record>

    <record id="group_raqib_user" model="res.groups">
        <field name="name">مدقق</field>
        <field name="privilege_id" ref="privilege_raqib"/>
    </record>

    <record id="group_raqib_manager" model="res.groups">
        <field name="name">مدير التدقيق</field>
        <field name="privilege_id" ref="privilege_raqib"/>
        <field name="implied_ids" eval="[(4, ref('group_raqib_user'))]"/>
    </record>
</odoo>
