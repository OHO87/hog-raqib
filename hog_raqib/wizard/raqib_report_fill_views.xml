<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_raqib_report_fill_form" model="ir.ui.view">
        <field name="name">raqib.report.fill.form</field>
        <field name="model">raqib.report.fill</field>
        <field name="arch" type="xml">
            <form string="تعبئة تقرير URS">
                <p>ارفع ملف Client Report (docx) كما ولّده URS CMS — سيعبأ من بيانات
                   هذا التدقيق: أيام التدقيق، الفريق، الموقع، العمليات، البنود
                   المفحوصة، والملاحظات المصنفة.</p>
                <group>
                    <field name="audit_id" readonly="1"/>
                    <field name="template_file" filename="template_filename"/>
                    <field name="template_filename" column_invisible="1"/>
                </group>
                <footer>
                    <button name="action_fill" type="object" string="تعبئة وتنزيل"
                            class="btn-primary"/>
                    <button string="إلغاء" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
